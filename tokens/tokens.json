{
  "$description": "AI Signal Board · Serenity Finance 调色板。emerald (信任/up) + cyan (数字/信号) + violet (CTA) + 炭灰 (无蓝调)。所有 CSS 变量应从此文件生成,避免散落硬编码。",

  "semantic": {
    "$description": "shadcn 风格 HSL 通道式语义 token (CSS 用法: hsl(var(--background)))。与 color.* 互补 — color.* 给具体色值, semantic.* 给主题语义。",

    "background":        { "value": "240 12% 5%",  "description": "页面底色 (炭黑, 非深蓝)" },
    "foreground":        { "value": "0 0% 95%",    "description": "主文本 (≥15:1 on page)" },
    "card":              { "value": "240 10% 8%",  "description": "卡片底色" },
    "card-foreground":   { "value": "0 0% 95%",    "description": "卡片文本" },
    "popover":           { "value": "240 12% 6%",  "description": "弹层底色" },
    "popover-foreground":{ "value": "0 0% 95%" },
    "muted":             { "value": "240 6% 14%",  "description": "弱化背景 (hover / track)" },
    "muted-foreground":  { "value": "240 5% 60%",  "description": "弱化文本 (~5.5:1 on page, 不抢主标题)" },
    "primary":           { "value": "160 70% 42%", "description": "主色 emerald (trust / up / AI, 降饱和护眼)" },
    "primary-foreground":{ "value": "0 0% 100%",   "description": "主色上的文本" },
    "secondary":         { "value": "189 80% 50%", "description": "次色 cyan (数字 / signal, 降饱和)" },
    "secondary-foreground":{ "value": "240 12% 5%" },
    "accent":            { "value": "262 70% 60%", "description": "强调色 violet (CTA, 降饱和)" },
    "accent-foreground": { "value": "0 0% 100%" },
    "destructive":       { "value": "0 72% 55%",   "description": "警示色 rose (down / 风险, 降饱和)" },
    "destructive-foreground":{ "value": "0 0% 100%" },
    "success":           { "value": "160 70% 42%" },
    "warning":           { "value": "38 80% 56%",   "description": "警示 (琥珀金, 仅用于 landing hero pill 区分, dashboard 用 cyan)" },
    "border":            { "value": "240 6% 18%" },
    "input":             { "value": "240 6% 18%" },
    "ring":              { "value": "160 70% 50%", "description": "焦点环 (emerald 提亮)" }
  },

  "color": {
    "$description": "色阶统一 50-950。灰阶采用炭黑中性色,无蓝调;状态色固化语义(up=涨 / down=跌 / warning=警示 / info=中性提示)。",

    "gray": {
      "50":  { "value": "#f5f5f7", "description": "最高对比文本 / 浅底面板" },
      "100": { "value": "#e5e5ea", "description": "次级文本" },
      "200": { "value": "#d4d4d8", "description": "辅助文本" },
      "300": { "value": "#a1a1aa", "description": "禁用 / 占位" },
      "400": { "value": "#71717a", "description": "弱化文本 (≥4.5:1 on gray-950)" },
      "500": { "value": "#52525b", "description": "分隔线" },
      "600": { "value": "#3f3f46", "description": "深底边框" },
      "700": { "value": "#27272a", "description": "深底 hover / track" },
      "800": { "value": "#1f1f24", "description": "shell-core 背景" },
      "900": { "value": "#14141a", "description": "次级背景" },
      "950": { "value": "#0a0a0f", "description": "页面 bg (炭黑, 非深蓝)" }
    },

    "emerald": {
      "$description": "主色 emerald — 信任 / 资金 / 上涨 / AI 主题",
      "300": { "value": "#6ee7b7" },
      "400": { "value": "#10b981", "description": "主色 emerald (up / AI 主题 / trust)" },
      "500": { "value": "#059669" },
      "600": { "value": "#047857" }
    },

    "cyan": {
      "$description": "次色 cyan — 数字 / 信号 / 综合得分",
      "300": { "value": "#67e8f9" },
      "400": { "value": "#06b6d4", "description": "主色 cyan (综合得分 / 焦点 / market 主题)" },
      "500": { "value": "#0891b2" },
      "600": { "value": "#0e7490" }
    },

    "violet": {
      "$description": "强调色 violet — 仅用于 CTA / primary action, 不用作数据色",
      "300": { "value": "#c4b5fd" },
      "400": { "value": "#a78bfa" },
      "500": { "value": "#7c3aed", "description": "主色 violet (CTA / primary button)" },
      "600": { "value": "#6d28d9" }
    },

    "rose": {
      "$description": "警示 rose — 下跌 / 负向变化 / 风险",
      "300": { "value": "#fca5a5" },
      "400": { "value": "#f87171" },
      "500": { "value": "#ef4444", "description": "主色 rose (down / 偏弱 / 风险)" },
      "600": { "value": "#dc2626" }
    },

    "surface": {
      "$description": "层叠玻璃面 (shell / shell-core / overlay / track)。rgba 直接写死,因其依赖透明度叠加。",
      "page":       { "value": "{color.gray.950}", "description": "页面底色" },
      "page-soft":  { "value": "{color.gray.900}", "description": "次级底色 / skip-link" },
      "shell":      { "value": "rgba(255, 255, 255, 0.025)" },
      "shell-hi":   { "value": "rgba(255, 255, 255, 0.045)" },
      "core":       { "value": "linear-gradient(180deg, rgba(20, 20, 26, 0.92), rgba(10, 10, 15, 0.88))" },
      "overlay":    { "value": "rgba(10, 10, 15, 0.72)" },
      "track":      { "value": "rgba(255, 255, 255, 0.04)" }
    },

    "border": {
      "subtle":  { "value": "rgba(255, 255, 255, 0.05)" },
      "default": { "value": "rgba(255, 255, 255, 0.08)" },
      "strong":  { "value": "rgba(255, 255, 255, 0.16)" },
      "focus":   { "value": "{color.emerald.400}" }
    },

    "text": {
      "primary":   { "value": "{color.gray.50}",  "description": "正文 / 标题 (≥15:1 on page)" },
      "secondary": { "value": "{color.gray.100}", "description": "次级正文 (≥13:1 on page)" },
      "muted":     { "value": "{color.gray.200}", "description": "辅助文本 (≥9:1 on page)" },
      "subtle":    { "value": "{color.gray.300}", "description": "占位 / 提示 (≥5.5:1 on page)" },
      "inverse":   { "value": "{color.gray.950}" }
    },

    "status": {
      "up":      { "value": "{color.emerald.400}", "description": "上涨 / 正向变化" },
      "down":    { "value": "{color.rose.500}",    "description": "下跌 / 负向变化" },
      "warning": { "value": "{color.cyan.300}",   "description": "警示 / 关注 (避免金色, 用亮青)" },
      "info":    { "value": "{color.cyan.400}",    "description": "中性提示" }
    },

    "theme": {
      "market": { "value": "{color.cyan.400}",     "description": "市场主题色" },
      "ai":     { "value": "{color.emerald.400}",  "description": "AI 主题色" },
      "score":  { "value": "{color.emerald.400}",  "description": "综合得分色 (用主色 emerald 突出)" }
    }
  },

  "font": {
    "$description": "字体家族来自 Google Fonts。设计系统规定 Heading/Body = IBM Plex Sans, 数字 = JetBrains Mono, 编辑级装饰 = IBM Plex Serif。",
    "family": {
      "sans":     { "value": "'IBM Plex Sans', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif", "description": "正文 / UI / 标题" },
      "display":  { "value": "'IBM Plex Sans', 'Noto Sans SC', sans-serif", "description": "大字号 display / kicker (含 smcp/ss01 数字特征)" },
      "serif":    { "value": "'IBM Plex Serif', 'Noto Serif SC', 'Songti SC', serif", "description": "编辑级斜体 / 装饰" },
      "mono":     { "value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace", "description": "代码 / ticker 数字" }
    },
    "size": {
      "2xs":  { "value": "0.6875rem",  "description": "10-11px, micro labels" },
      "xs":   { "value": "0.75rem",    "description": "12px, meta" },
      "sm":   { "value": "0.875rem",   "description": "14px, body small" },
      "base": { "value": "1rem",       "description": "16px, body" },
      "lg":   { "value": "1.125rem",   "description": "18px, subtitle" },
      "xl":   { "value": "1.375rem",   "description": "22px, section title" },
      "2xl":  { "value": "1.75rem",    "description": "28px, h2" },
      "3xl":  { "value": "2.25rem",    "description": "36px, h1" },
      "4xl":  { "value": "3rem",       "description": "48px, display" },
      "5xl":  { "value": "3.75rem",    "description": "60px, hero display" },
      "6xl":  { "value": "5rem",       "description": "80px, editorial accent" },
      "7xl":  { "value": "7.5rem",     "description": "120px, massive display" },
      "8xl":  { "value": "10rem",      "description": "160px, landing hero" }
    },
    "weight": {
      "regular":  { "value": "400" },
      "medium":   { "value": "500" },
      "semibold": { "value": "600" },
      "bold":     { "value": "700" }
    },
    "leading": {
      "tight":   { "value": "1.05", "description": "display / editorial" },
      "snug":    { "value": "1.2",  "description": "标题" },
      "normal":  { "value": "1.5",  "description": "正文" },
      "relaxed": { "value": "1.75", "description": "长文 / 摘要" }
    },
    "tracking": {
      "tight":   { "value": "-0.04em" },
      "snug":    { "value": "-0.02em" },
      "normal":  { "value": "0" },
      "wide":    { "value": "0.04em" },
      "wider":   { "value": "0.12em" },
      "widest":  { "value": "0.24em" }
    }
  },

  "space": {
    "$description": "4pt 网格。所有 padding / gap 必须用 space token, 不写 px。",
    "0":  { "value": "0" },
    "1":  { "value": "0.25rem" },
    "2":  { "value": "0.5rem" },
    "3":  { "value": "0.75rem" },
    "4":  { "value": "1rem" },
    "5":  { "value": "1.25rem" },
    "6":  { "value": "1.5rem" },
    "7":  { "value": "1.75rem" },
    "8":  { "value": "2rem" },
    "9":  { "value": "2.25rem" },
    "10": { "value": "2.5rem" },
    "12": { "value": "3rem" },
    "14": { "value": "3.5rem" },
    "16": { "value": "4rem" },
    "20": { "value": "5rem" },
    "24": { "value": "6rem" },
    "32": { "value": "8rem" },
    "40": { "value": "10rem" },
    "48": { "value": "12rem" }
  },

  "border": {
    "$description": "边框宽度 / 描边",
    "width": {
      "hair":  { "value": "0.5px", "description": "极致细线" },
      "thin":  { "value": "1px",   "description": "默认" },
      "reg":   { "value": "1.5px", "description": "强调边框" },
      "bold":  { "value": "2px",   "description": "重点描边" }
    }
  },

  "opacity": {
    "$description": "不透明度阶梯",
    "0":   { "value": "0" },
    "5":   { "value": "0.05" },
    "8":   { "value": "0.08" },
    "12":  { "value": "0.12" },
    "20":  { "value": "0.2" },
    "40":  { "value": "0.4" },
    "60":  { "value": "0.6" },
    "80":  { "value": "0.8" },
    "100": { "value": "1" }
  },

  "breakpoint": {
    "$description": "响应式断点 (max-width)",
    "sm": { "value": "640px" },
    "md": { "value": "768px" },
    "lg": { "value": "1024px" },
    "xl": { "value": "1280px" },
    "2xl":{ "value": "1536px" }
  },

  "radius": {
    "none": { "value": "0" },
    "xs":   { "value": "0.5rem" },
    "sm":   { "value": "0.75rem" },
    "md":   { "value": "1.125rem" },
    "lg":   { "value": "1.5rem" },
    "xl":   { "value": "2rem" },
    "2xl":  { "value": "2.25rem" },
    "full": { "value": "9999px" }
  },

  "shadow": {
    "card":        { "value": "0 30px 80px -20px rgba(0, 0, 0, 0.65), 0 2px 0 rgba(255, 255, 255, 0.02) inset" },
    "inset":       { "value": "inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 -1px 0 rgba(0, 0, 0, 0.4)" },
    "ring":        { "value": "0 0 0 3px rgba(16, 185, 129, 0.3)", "description": "focus ring (emerald)" },
    "glow":        { "value": "0 0 24px rgba(16, 185, 129, 0.35)", "description": "强调 / 数据更新闪烁" },
    "glow-violet": { "value": "0 0 40px rgba(124, 58, 237, 0.35)", "description": "CTA violet 辉光" },
    "glow-cyan":   { "value": "0 0 24px rgba(6, 182, 212, 0.32)", "description": "数字青辉光" },
    "topbar":      { "value": "0 18px 50px -10px rgba(0, 0, 0, 0.6)" }
  },

  "motion": {
    "$description": "运动统一用 ease-spring 长尾, dur-fast 用于微交互, dur 用于面板。",
    "duration": {
      "instant": { "value": "120ms" },
      "fast":    { "value": "260ms" },
      "base":    { "value": "480ms" },
      "slow":    { "value": "780ms" },
      "lazy":    { "value": "1200ms" }
    },
    "easing": {
      "out":   { "value": "cubic-bezier(0.32, 0.72, 0, 1)",      "description": "标准出场" },
      "spring":{ "value": "cubic-bezier(0.34, 1.4, 0.64, 1)",     "description": "弹跳出场" },
      "in":    { "value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },

  "z": {
    "base":  { "value": "0" },
    "raised":{ "value": "2" },
    "sticky":{ "value": "50" },
    "overlay":{ "value": "100" },
    "modal": { "value": "200" },
    "toast": { "value": "300" }
  },

  "layout": {
    "max-width":  { "value": "1400px" },
    "gutter":     { "value": "calc(100% - {layout.max-width})", "description": "两侧留白参考" },
    "gutter-d":   { "value": "calc(100% - 48px)" },
    "gutter-m":   { "value": "calc(100% - 24px)" }
  }
}
